{
  "Server": {
    "Host": "localhost",
    "Port": 5712,
    "Path": "/mcp",
    "Password": ""
  },
  "Kodi": {
    "DefaultAlias": "",
    "ReadOnly": true,
    "Controls": {
      "AllowPlayback": false,
      "AllowPlayerControl": false,
      "AllowSeek": false,
      "AllowVolume": false,
      "AllowStreamSelection": false,
      "AllowPlaybackModes": false,
      "AllowPlaylists": false,
      "AllowFullscreenVideo": false,
      "AllowWatchState": false,
      "AllowFavourites": false,
      "AllowLibraryScan": false,
      "AllowLibraryClean": false
    },
    "RequestTimeoutSeconds": 10,
    "MaximumResponseBytes": 2097152,
    "MaximumPageSize": 50,
    "Handles": {
      "LifetimeMinutes": 15,
      "Capacity": 5000
    },
    "LearnedRoutes": {
      "Directory": "kodimcpsharp_data/addon-routes",
      "AllowWrite": false,
      "MaximumRoutesPerAddon": 100
    },
    "Instances": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kodimcp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ]
  }
}
